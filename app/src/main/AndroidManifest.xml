<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy rule: this app does not request the INTERNET permission.
      Do not add network access or analytics without an accepted proposal (see CONTRIBUTING.md).
    -->

    <!--
      Optional permissions, each asked for by the user in Settings and only used on this device:
      usage access (screen time), display over other apps (floating timer, red button), calendar read (Agenda widget).
      Do Not Disturb access is granted in system settings and needs no manifest permission here.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Background noise player in Quick actions: a media-playback foreground service with a Stop notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The Still live wallpaper is optional, so phones without live wallpaper support can still install the app. -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <!-- Lets us list launchable apps on Android 11+ without the broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <!-- HOME + DEFAULT makes Android offer this app as a home screen replacement. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating timer shown over a gated app while a session runs. -->
        <service
            android:name=".service.SessionOverlayService"
            android:exported="false" />

        <!-- White, pink and brown noise made in code. No audio files, no network. -->
        <service
            android:name=".service.NoiseService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The red button drawn over other apps. Runs only when the user turns it on and allows "Display over other apps". -->
        <service
            android:name=".service.UrgeButtonService"
            android:exported="false" />

        <!-- Still live wallpaper for the Home and Lock screen. No permission needed to offer it; Android asks the user to apply it. -->
        <service
            android:name=".service.StillWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/still_wallpaper" />
        </service>
    </application>
</manifest>
