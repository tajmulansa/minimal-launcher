<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy rule: this app does not request the INTERNET permission.
      Do not add network access or analytics without an accepted proposal (see CONTRIBUTING.md).
    -->

    <!--
      Optional permissions, each asked for by the user in Settings and only used on this device:
      usage access (screen time), display over other apps (floating timer, red button), notification access (red button lock).
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Lets us list launchable apps on Android 11+ without the broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <!-- HOME + DEFAULT makes Android offer this app as a home screen replacement. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating timer shown over an app while its time runs. -->
        <service
            android:name=".service.SessionOverlayService"
            android:exported="false" />

        <!-- The red button drawn over other apps. Runs only when the user turns it on and allows "Display over other apps". -->
        <service
            android:name=".service.UrgeButtonService"
            android:exported="false" />

        <!-- Dismisses every notification during the red button lock. Active only if "Notification access" is allowed. -->
        <service
            android:name=".service.NotificationGuardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
